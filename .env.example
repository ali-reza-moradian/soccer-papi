# Executor credentials — COPY this file to .env and fill in your own values.
# .env and secrets/ are gitignored; NEVER commit real keys. Placeholders only here.

# Kalshi (REST trading). KALSHI_API_KEY_ID is the API key id (not the secret); the RSA private
# key lives in a .pem file referenced by path (keep the .pem under the gitignored secrets/ folder).
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=secrets/kalshi_private_key.pem

# Polymarket (CLOB trading). POLYGON_PRIVATE_KEY is the signer EOA key; POLY_SIGNATURE_TYPE 3 =
# deposit/proxy wallet; POLY_FUNDER_ADDRESS is your deposit/proxy wallet address.
POLYGON_PRIVATE_KEY=
POLY_SIGNATURE_TYPE=3
POLY_FUNDER_ADDRESS=
