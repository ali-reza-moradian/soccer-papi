# Copy this file to scripts\secrets.local.ps1 (which is gitignored) and fill in the real values.
# run_scan.ps1 dot-sources it so these become environment variables for `python -m src.run`.
#
#   Copy-Item scripts\secrets.local.ps1.example scripts\secrets.local.ps1
#
# NEVER commit the filled-in secrets.local.ps1.

$env:ODDS_PAPI_KEY    = ''   # OddsPapi API key (budget guard + cached catalog/name-map refreshes)
$env:ODDS_API_KEY     = ''   # the-odds-api.com key (Pinnacle + 1xBet odds in the free profile)
$env:TELEGRAM_BOT_KEY = ''   # Telegram bot token
$env:TELEGRAM_GROUP_ID = ''  # Telegram chat_id to post to
