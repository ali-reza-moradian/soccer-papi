# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Test / tooling
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Local secrets (never commit) — secrets live in GitHub Actions only (and, on the VM, in the
# gitignored scripts/secrets.local.ps1 that run_scan.ps1 sources).
.env
*.local.env
secrets.yaml
scripts/secrets.local.ps1
# Executor credentials: the .env file and the secrets/ folder (Kalshi .pem, etc.) — NEVER commit.
# Only .env.example (placeholders) is tracked.
secrets/

# NOTE: data/ is intentionally committed (CSV history + cached catalogs).
# EXCEPT the Excel running log: it is a BINARY file rewritten every scan, so committing it would
# create merge conflicts on the automated CSV commit-back and bloat history. It is a VM-local
# artifact (LOCAL_RUN skips git anyway); the text CSV remains the committed source of truth.
data/arbs_log.xlsx
# Transient single-instance scan lock (pid + start time); never commit.
data/scan.lock
# Executor RUNTIME artifacts (regenerable local state, like arbs_log.xlsx): the dry-run/ledger
# logs, the event log, and the STOP kill-switch. Never commit (committing STOP would halt the
# executor for anyone who pulls). `python -m src.executor.cli selfcheck` regenerates samples.
data/executor/
# Derived group-tier slug/token cache (rebuilt on its own TTL); only written when group_markets on.
data/cache/group_slugmap.json
# Claude Code local session/agent state — never commit.
.claude/
# Supervisor runtime: logs, heartbeat, STOP_ALL flag (scripts/run_all.ps1). Machine-local, never commit.
data/ops/

data/cache/
data/arbitrage_opportunities.csv
data/arbs_log.xlsx
data/og_current.json
# OG multi-sport (src/og_multi/) runtime outputs + caches — regenerable, never committed (the panel
# HTML that reads them lives under data/genz/ and IS committed via the !data/genz/*.html rule below).
data/og_current_*.json
data/og_multi/
data/genz/*
!data/genz/*.html
